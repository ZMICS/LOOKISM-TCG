    if "form" in card:
        print("Form :", card["form"])

    print("Type :", card["type"])
    print("Rank :", card["rank"])
    print("Stage:", card["upgrade_stage"])
    print("ATK  :", card["attack"])
    print("HP   :", card["hp"])
    print("DEF  :", card["defense"])
    print("SPD  :", card["speed"])
    print("==========================")
def roll_fighter():
    fighters = []

    for card in cards:
        if card["type"] == "Fighter":
            fighters.append(card)

    return random.choice(fighters)
def roll_card():
    return roll_fighter()
def roll_boost():
    boosts = []

    for card in cards:
        if card["type"] == "Boost":
            boosts.append(card)

    return random.choice(boosts)
