def get_card_by_id(card_id):
    for card in cards:
        if card["id"] == card_id:
            return card
    return None
def get_card_by_name(name):
    for card in cards:
        if card["name"] == name:
            return card
    return None
def get_cards_by_type(card_type):
    result = []

    for card in cards:
        if card["type"] == card_type:
            result.append(card)

    return result
def show_all_cards():
    return cards
def show_card(card_id):
    card = get_card_by_id(card_id)

    if card is None:
        print("Card not found!")
        return

    print("=========================")
    print("Name:", card["name"])

    if "form" in card:
        print("Form:", card["form"])

    print("Type:", card["type"])
    print("Upgrade Stage:", card["upgrade_stage"])
    print("UI Mode:", card["ui_mode"])
    print("Path:", card["path"])

    if card["type"] == "Fighter":
        print("Attack:", card["attack"])
        print("HP:", card["hp"])
        print("Defense:", card["defense"])
        print("Speed:", card["speed"])

    elif card["type"] == "Boost":
        print("Effect:", card["effect"])

    print("=========================")
def get_character_cards(character_name):
    character_cards = []

    for card in cards:
        if card["name"] == character_name:
            character_cards.append(card)

    return character_cards
def get_strongest_fighter():
    strongest = None

    for card in cards:
        if card["type"] != "Fighter":
            continue

        if strongest is None:
            strongest = card

        elif card["attack"] > strongest["attack"]:
            strongest = card

    return strongest
def get_battle_power(card):
    if card["type"] != "Fighter":
        return 0

    battle_power = (
        card["attack"] +
        card["hp"] +
        card["defense"] +
        card["speed"]
    )

    return battle_power
def show_battle_power():
    for card in cards:
        if card["type"] == "Fighter":
            power = get_battle_power(card)
            print(f"{card['name']} : {power}") 
def upgrade_to_c_rank(card, attack_increase, hp_increase, defense_increase, speed_increase):
    if card["type"] != "Fighter":
        return None

    upgraded = card.copy()

    upgraded["rank"] = "C"
    upgraded["upgrade_stage"] = 2

    upgraded["attack"] += attack_increase
    upgraded["hp"] += hp_increase
    upgraded["defense"] += defense_increase
    upgraded["speed"] += speed_increase

    return upgraded
def upgrade_card(card):
    current_id = card["id"]

    # Split the ID into character name and stage number
    name, stage = current_id.rsplit("_", 1)

    # Calculate the next stage
    next_stage = int(stage) + 1

    # Create the next card ID
    next_id = f"{name}_{next_stage}"

    # Return the next card
    return get_card_by_id(next_id)
import random

def upgrade_card(card):
    if card["type"] != "Fighter":
        return None

    upgraded = card.copy()

    # Maximum rank check
    if upgraded["rank"] == "S":
        print("This card is already at the maximum rank.")
        return upgraded

    # Rank progression
    rank_order = {
        "D": "C",
        "C": "B",
        "B": "A",
        "A": "S"
    }

    upgraded["rank"] = rank_order[upgraded["rank"]]

    # Increase upgrade stage
    upgraded["upgrade_stage"] += 1

    # Increase stats
    upgraded["attack"] += random.randint(20, 40)
    upgraded["hp"] += random.randint(20, 40)
    upgraded["defense"] += random.randint(20, 40)
    upgraded["speed"] += random.randint(20, 40)

    return upgraded
def display_card(card):
    print("========== CARD ==========")
